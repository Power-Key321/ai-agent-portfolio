# 统一换行符，避免跨平台协作时的 CRLF/LF 噪音
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.xlsx binary

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Markdown 与代码统一 LF
*.md   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
